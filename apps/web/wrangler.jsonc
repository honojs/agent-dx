{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name = subdomain: agent-dx.hono.dev
  "name": "agent-dx",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-30",
  "routes": [{ "pattern": "agent-dx.hono.dev", "custom_domain": true }],
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "RESULTS",
      "bucket_name": "agent-dx-results",
      // Dev and the SSG script read the real bucket.
      "remote": true,
    },
  ],
}
