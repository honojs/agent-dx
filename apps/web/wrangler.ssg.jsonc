{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Remote R2 access for the SSG script (scripts/ssg.mts).
  "name": "agent-dx-ssg",
  "compatibility_date": "2026-08-30",
  "r2_buckets": [
    {
      "binding": "RESULTS",
      "bucket_name": "agent-dx-results",
      "remote": true,
    },
  ],
}
