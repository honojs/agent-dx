{
  "name": "@hono/agent-dx",
  "version": "0.1.0",
  "description": "Measure and improve the developer experience of coding agents using Hono",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honojs/agent-dx.git"
  },
  "homepage": "https://agent-dx.hono.dev",
  "bin": {
    "agent-dx": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@flue/runtime": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
